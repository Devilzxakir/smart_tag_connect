# Mobile app configuration (copy to `mobile/.env`).
#
# Only the Supabase *publishable* key belongs here. It is public by design and
# ships inside every web and mobile bundle. Never put the service-role key in
# a mobile build.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: public HTTPS origin used for permanent dynamic-tag links
# (/t/<code>). Defaults to https://smart-tag-connect.vercel.app
# EXPO_PUBLIC_PUBLIC_APP_URL=https://smart-tag-connect.vercel.app
